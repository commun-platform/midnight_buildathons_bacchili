{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "midnight-verification-mcp",
  "main": "../verification-mcp-worker/src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "alias": {
    "@midnight-ntwrk/onchain-runtime-v3": "../verification-mcp-worker/src/onchain-runtime-worker.js"
  },
  "vars": {
    "VERIFICATION_MCP_HOST": "midnight-verification-mcp.commun-official.workers.dev",
    "ALLOWED_SENSOR_REGISTRY_CONTRACTS": "48636e2f7ae8b1705134b026ec0d5a910357cac990a60adce2c2672e1a78a732"
  },
  "ratelimits": [
    {
      "name": "VERIFY_RATE_LIMITER",
      "namespace_id": "52874016",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  }
}
