{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "midnight-proof-gateway",
  "main": "../proof-gateway-worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midnight-sensor-data-v2",
      "migrations_dir": "../d1-schema/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SPONSOR_STATE",
      "bucket_name": "midnight-sponsor-wallet-state"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROOF_QUEUE",
        "queue": "midnight-proof-jobs"
      },
      {
        "binding": "SPONSOR_QUEUE",
        "queue": "midnight-sponsor-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "midnight-proof-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "midnight-proof-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-sponsor-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 12,
        "dead_letter_queue": "midnight-sponsor-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "49063811",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "73194502",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PROOF_RATE_LIMITER",
      "namespace_id": "84731026",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "containers": [
    {
      "name": "midnight-proof-server",
      "class_name": "ProofServerContainer",
      "image": "docker.io/midnightntwrk/proof-server:8.1.0",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "name": "midnight-sponsor-wallet",
      "class_name": "SponsorWalletContainer",
      "image": "../sponsor-wallet-container/Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROOF_SERVER",
        "class_name": "ProofServerContainer"
      },
      {
        "name": "SPONSOR_WALLET",
        "class_name": "SponsorWalletContainer"
      }
    ]
  },
  "exports": {
    "ProofServerContainer": {
      "type": "durable-object",
      "container": "midnight-proof-server",
      "storage": "sqlite"
    },
    "SponsorWalletContainer": {
      "type": "durable-object",
      "container": "midnight-sponsor-wallet",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "../../../frontend/verification-portal/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/api/*", "/health", "/ready", "/check", "/prove", "/proof/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
