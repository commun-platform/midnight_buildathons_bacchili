{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "midnight-proof-gateway",
  "main": "../proof-gateway-worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "PUBLIC_VERIFICATION_PORTAL_URL": "https://midnight-proof-gateway.commun-official.workers.dev",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://morning-unit-c72e.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUDIENCE": "1e64d80f43ed648a2e7c0bfb059c737f76f27ab311cb786d84ab793d296460f9",
    "OPERATIONS_ALERT_LOW_DUST_TRANSACTIONS": "1",
    "OPERATIONS_ALERT_SYNC_LAG_BLOCKS": "250",
    "OPERATIONS_ALERT_WALLET_GRACE_MINUTES": "5",
    "OPERATIONS_ALERT_PROOF_BACKLOG": "8",
    "OPERATIONS_ALERT_PROOF_BACKLOG_AGE_MINUTES": "10",
    "OPERATIONS_ALERT_SPONSOR_BACKLOG": "16",
    "OPERATIONS_ALERT_SPONSOR_BACKLOG_AGE_MINUTES": "10",
    "OPERATIONS_ALERT_PROOF_RATE_LIMIT_EVENTS": "5",
    "OPERATIONS_ALERT_REMINDER_MINUTES": "60"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midnight-sensor-data-v2",
      "migrations_dir": "../d1-schema/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SPONSOR_STATE",
      "bucket_name": "midnight-sponsor-wallet-state"
    },
    {
      "binding": "MANAGED_SOURCE_DATA",
      "bucket_name": "midnight-managed-source-private"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROOF_QUEUE",
        "queue": "midnight-proof-jobs"
      },
      {
        "binding": "SPONSOR_QUEUE",
        "queue": "midnight-sponsor-jobs"
      },
      {
        "binding": "MANAGED_SOURCE_QUEUE",
        "queue": "midnight-managed-source-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "midnight-proof-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "midnight-proof-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-sponsor-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 12,
        "dead_letter_queue": "midnight-sponsor-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-managed-source-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 12,
        "dead_letter_queue": "midnight-managed-source-jobs-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-proof-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-sponsor-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "midnight-managed-source-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "49063811",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "73194502",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PROOF_RATE_LIMITER",
      "namespace_id": "84731026",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "containers": [
    {
      "name": "midnight-proof-server",
      "class_name": "ProofServerContainer",
      "image": "docker.io/midnightntwrk/proof-server:8.1.0",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "name": "midnight-server-wallet",
      "class_name": "ServerWalletContainer",
      "image": "../sponsor-wallet-container/Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROOF_SERVER",
        "class_name": "ProofServerContainer"
      },
      {
        "name": "SPONSOR_WALLET",
        "class_name": "ServerWalletContainer"
      }
    ]
  },
  "exports": {
    "ProofServerContainer": {
      "type": "durable-object",
      "container": "midnight-proof-server",
      "storage": "sqlite"
    },
    "ServerWalletContainer": {
      "type": "durable-object",
      "container": "midnight-server-wallet",
      "storage": "sqlite"
    },
    "SponsorWalletContainer": {
      "type": "durable-object",
      "state": "deleted"
    },
    "FleetAuthorityContainer": {
      "type": "durable-object",
      "state": "deleted"
    },
    "ManagedAttestorContainer": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "assets": {
    "directory": "../../../frontend/verification-portal/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/api/*", "/system-operations", "/system-operations/*", "/health", "/ready", "/check", "/prove", "/proof/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  }
}
