MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=https://midnight-proof-gateway.<your-subdomain>.workers.dev/proof
MIDNIGHT_PROOF_SERVER_TOKEN=replace-with-the-same-value-as-PROOF_GATEWAY_TOKEN
# The development wallet is persisted here. Back up this file securely.
# On first `npm run development:wallet`, a new mnemonic is written here if both are empty.
DEVELOPMENT_WALLET_MNEMONIC=
DEVELOPMENT_WALLET_SEED=
DEVELOPMENT_PRIVATE_STATE_PASSWORD=Replace-with-16-plus-chars-1!
MIDNIGHT_SYNC_TIMEOUT_MS=3600000
MIDNIGHT_DUST_TIMEOUT_MS=43200000
MIDNIGHT_DUST_BATCH_SIZE=100

# Optional endpoint overrides
# MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
