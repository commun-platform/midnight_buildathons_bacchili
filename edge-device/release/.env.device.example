# Staging configuration for device installation. The installer moves configured
# values to ~/.midnight/midnight-cloudflare-demo/config/device.env and removes
# the staged .env.device. Wallet recovery material is never stored here.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=https://midnight-proof-gateway.<your-subdomain>.workers.dev
# Filled by `npm run device:configure` after the public Device key is activated.
DEVICE_CONTRACT_ADDRESS=
MIDNIGHT_SYNC_TIMEOUT_MS=3600000
MIDNIGHT_DUST_TIMEOUT_MS=43200000
MIDNIGHT_DUST_BATCH_SIZE=100

# Temperature collection
CLOUDFLARE_INGEST_URL=https://midnight-proof-gateway.<your-subdomain>.workers.dev
TEMPERATURE_SENSOR_PATH=/sys/class/thermal/thermal_zone0/temp
SENSOR_INTERVAL_SECONDS=60
SENSOR_PROJECT_ID=measurement-authenticity-01
SENSOR_DEVICE_ID=edge-temp-001
# Use synthetic only for demonstrations and integration tests.
SENSOR_MODE=hardware
SYNTHETIC_TEMPERATURE_BASE=22
SYNTHETIC_TEMPERATURE_AMPLITUDE=2
# Web2 immediate-alert thresholds only. The ZK circuit never reads these values;
# it uses the public policy registered on Midnight before operation.
SENSOR_NORMAL_MINIMUM=10
SENSOR_NORMAL_MAXIMUM=35
ANOMALY_HYSTERESIS=0.5
ANOMALY_DEBOUNCE_SAMPLES=3
ANOMALY_COOLDOWN_SECONDS=300
THRESHOLD_POLICY_VERSION=temperature-v1
POLICY_ASSIGNMENT_ID=edge-temp-001-temperature-v1-wave1
# Optional override. The default is ~/.midnight/midnight-cloudflare-demo/device-auth.
DEVICE_AUTH_HOME=
AGENT_PORT=8788
