# Local input used only by configuration scripts. Never commit .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-id/replace-token

# Independent 32-byte secrets, encoded as 64 lowercase hexadecimal characters.
# `npm run cloudflare:config:managed-attestation -- --generate` can create them
# in the ignored .env file and configure the Worker without printing values.
MANAGED_ATTESTOR_ROOT_SECRET=
MANAGED_CONNECTOR_CREDENTIAL_KEY=
MANAGED_ARTIFACT_ENCRYPTION_KEY=
