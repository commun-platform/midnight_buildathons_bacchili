# Staging configuration for device installation. The installer moves configured
# values to ~/.midnight/midnight-cloudflare-demo/config/device.env and removes
# the staged .env.device. Wallet recovery material is never stored here.
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=https://midnight-proof-gateway.<your-subdomain>.workers.dev/proof
MIDNIGHT_PROOF_SERVER_TOKEN=replace-with-the-same-value-as-PROOF_GATEWAY_TOKEN
DEVICE_CONTRACT_ADDRESS=
MIDNIGHT_SYNC_TIMEOUT_MS=3600000
MIDNIGHT_DUST_TIMEOUT_MS=43200000
MIDNIGHT_DUST_BATCH_SIZE=100

# Temperature collection
CLOUDFLARE_INGEST_URL=https://midnight-proof-gateway.<your-subdomain>.workers.dev/api/v1/readings
INGEST_API_TOKEN=replace-with-the-same-value-as-the-worker-ingest-secret
TEMPERATURE_SENSOR_PATH=/sys/class/thermal/thermal_zone0/temp
SENSOR_INTERVAL_SECONDS=60
SENSOR_PROJECT_ID=measurement-authenticity-01
SENSOR_DEVICE_ID=edge-temp-001
AGENT_PORT=8788
